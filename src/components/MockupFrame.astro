---
interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  priority?: boolean;
  slotName: string;
  reveal?: 'feature-visual';
  frameClass?: string;
}

const { src, alt, width, height, priority = false, slotName, reveal, frameClass } = Astro.props;
---

<figure
  class:list={['mockup-frame', frameClass]}
  data-slot={slotName}
  data-alt={alt}
  data-reveal={reveal}
  style={`--mockup-ratio: ${width} / ${height}`}
>
  <img
    src={src}
    alt={alt}
    width={width}
    height={height}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
    decoding="async"
    style={`aspect-ratio: ${width} / ${height}`}
  />
</figure>
